# CloudVeil environment configuration — copy to .env and fill in.
# .env is gitignored and must NEVER be committed.

# ---- Azure ----
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_RESOURCE_GROUP=rg-cloudveil
AZURE_PRIMARY_REGION=centralindia
AZURE_SECONDARY_REGION=southeastasia
# lowercase letters + digits, short, globally unique (used to build resource names)
NAME_PREFIX=cloudveil7k3

# ---- MySQL Flexible Server admin (strong password; stays only here + App Service settings) ----
MYSQL_ADMIN_USER=cvadmin
MYSQL_ADMIN_PASSWORD=change-me-12+chars-Upper-lower-digit-symbol

# ---- First admin login for the CloudVeil web app ----
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password

# ---- GitHub ----
GITHUB_REPO=your-username/cloudveil

# ---- Application runtime (set in App Service; examples only) ----
# These are populated by infra/app_settings.sh in Phase 2. Do not fill locally.
# KEYVAULT_URL=https://<vault>.vault.azure.net/
# KEK_NAME=cloudveil-kek
# STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net/
# STORAGE_CONTAINER=encrypted-files
# PRIMARY_REGION=centralindia
# JWT_SECRET=<generated>
# APPLICATIONINSIGHTS_CONNECTION_STRING=<generated>
